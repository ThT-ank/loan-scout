{
	"name": "loan-scout",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "zellij --layout loan-scout.kdl",
		"dev:api": "cd api && source .venv/bin/activate && python -m uvicorn main:app --reload --port 8000",
		"dev:webapp": "pnpm --filter=./webapp dev",
		"format": "dprint fmt",
		"format-check": "dprint check",
		"lint:api": "cd api && source .venv/bin/activate && pylint . --ignore=.venv --recursive=y",
		"lint:webapp": "pnpm --filter=./webapp lint",
		"lint": "pnpm lint:api && pnpm lint:webapp",
		"build": "pnpm --filter=./webapp build"
	},
	"packageManager": "pnpm@10.22.0"
}
